{
  "name": "doc-video",
  "version": "1.0.0",
  "private": true,
  "scripts": {
    "dev": "remotion studio src/index.ts",
    "preview": "remotion studio src/index.ts",
    "check": "tsc --noEmit && node --experimental-strip-types --test tests/data.test.mjs",
    "render:smoke": "remotion render src/index.ts Documentario out/smoke.mp4 --frames=0-29 --concurrency=2",
    "render": "remotion render src/index.ts Documentario out/video.mp4 --concurrency=4"
  },
  "dependencies": {
    "@remotion/cli": "^4.0.0",
    "lucide-react": "^1.61.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "remotion": "^4.0.0"
  },
  "devDependencies": {
    "@types/react": "^18.3.0",
    "typescript": "^5.4.0"
  }
}
